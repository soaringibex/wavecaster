! WRF namelist — Mt Washington wave pipeline (pinned; rationale below).
! Domain/case values are set for the 2026-10-06 12Z verification case; the run
! script rewrites start/end (and the num_metgrid_* placeholders) per cycle.

&time_control
! 36 h at 00/06/12/18Z cycles (the only cycles HRRR runs long enough).
 run_days = 0,
 run_hours = 36,
 run_minutes = 0,
 run_seconds = 0,
 start_year = 2026, 2026,
 start_month = 10, 10,
 start_day = 06, 06,
 start_hour = 12, 12,
 start_minute = 00, 00,
 start_second = 00, 00,
! real.exe falls back to the registry-default end date (1993-03-14) unless
! end_* are present, so they are always written out; the run script rewrites
! start_* and end_* together each cycle (end = start + run_hours).
 end_year = 2026, 2026,
 end_month = 10, 10,
 end_day = 08, 08,
 end_hour = 00, 00,
 end_minute = 00, 00,
 end_second = 00, 00,
 interval_seconds = 3600,
 input_from_file = .true., .true.,
! 1 h for d01, 15 min for the 1 km nest (the nest is the product).
 history_interval = 60, 15,
 frames_per_outfile = 1000, 1000,
 restart = .false.,
 io_form_history = 2,
 io_form_restart = 2,
 io_form_input = 2,
 io_form_boundary = 2,
! Trim the history streams to what the post-process reads (fields not listed are
! removed); the lists are verified against an actual wrfout after the smoke run.
 iofields_filename = 'iofields_d01.txt', 'iofields_d02.txt',
 ignore_iofields_warning = .true.,
 debug_level = 0,
/

&domains
! 5:1 time-step ratio vs dx (15 s at 3 km, 5 s at 1 km) — well inside stability.
 time_step = 15,
 max_dom = 2,
 e_we = 121, 151,
 e_sn = 121, 151,
 e_vert = 100, 100,
! 10 hPa lid. With the Rayleigh damping layer this keeps mountain waves from
! reflecting off the top back into the field we are producing.
 p_top_requested = 1000,
! Filled by run-cycle.sh from the met_em headers — never hardcoded here.
 num_metgrid_levels = -999,
 num_metgrid_soil_levels = -999,
 dx = 3000, 1000,
 dy = 3000, 1000,
 grid_id = 1, 2,
 parent_id = 0, 1,
 i_parent_start = 1, 36,
 j_parent_start = 1, 36,
 parent_grid_ratio = 1, 3,
 parent_time_step_ratio = 1, 3,
 feedback = 0,
 smooth_cg_topo = .true.,
! Vertical grid retuned for the duct (wrf/PLAN.md): dzbot = 50 m, then a
! 3.5%/level geometric stretch (dzstretch_s = dzstretch_u, so the max_dz blend
! is inert and max_dz acts only as the upper-thickness guard). A replica of WRF
! 4.6.1's levels() routine confirms ≤ ~120 m through 2 km, ≤ ~250 m through
! 5 km, and 100 levels reaching 10 hPa without the upper-level fatal.
 auto_levels_opt = 2,
 dzbot = 50.,
 dzstretch_s = 1.035,
 dzstretch_u = 1.035,
 max_dz = 1000.,
/

&physics
! Thompson (mp=8): fog/riming for the cap, lenticular and rotor cloud.
! RRTMG (4/4) for both domains; MYNN surface layer + PBL (5/5) for stable,
! strongly stratified nights over the range; Noah LSM (2). No cumulus at 3 km
! or 1 km — the grid resolves the convection, and cu=0 avoids double counting
! the wave's own cloud.
 mp_physics = 8, 8,
 ra_lw_physics = 4, 4,
 ra_sw_physics = 4, 4,
 radt = 3, 3,
 sf_sfclay_physics = 5, 5,
 sf_surface_physics = 2, 2,
 bl_pbl_physics = 5, 5,
 cu_physics = 0, 0,
 num_land_cat = 21,
/

&dynamics
! hybrid_opt = 2 = height-based hybrid coordinate near the top (with the
! Rayleigh layer). diff_opt 2 / km_opt 4 / epssm 0.5 is the stable
! high-resolution combination over steep 1 km terrain. w_damping = 0 on
! purpose: we are producing W and must not clip it.
 hybrid_opt = 2,
 diff_opt = 2, 2,
 km_opt = 4, 4,
 damp_opt = 3,
 zdamp = 5000., 5000.,
 dampcoef = 0.2, 0.2,
 w_damping = 0,
 epssm = 0.5, 0.5,
 non_hydrostatic = .true., .true.,
/

&bdy_control
 spec_bdy_width = 5,
 spec_zone = 1,
 relax_zone = 4,
 specified = .true., .false.,
 nested = .false., .true.,
/

&namelist_quilt
 nio_tasks_per_group = 0,
 nio_groups = 1,
/
